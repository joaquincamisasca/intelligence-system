# Copiá este archivo como .env y completá SOLO lo que uses.
# Con los valores por defecto el sistema funciona 100% local y gratis
# (Ollama + Chroma + embeddings locales): no hace falta ninguna API key.

# --- LLM ---
# "ollama" (default, gratis y local), "openai" o "anthropic"
GENERATION_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# Ventana de contexto (el default de Ollama es chico y corta los prompts largos)
OLLAMA_NUM_CTX=8192
# Con Docker, Ollama en tu compu se alcanza en host.docker.internal (ya viene por defecto en el compose).
# Si corrés la API SIN Docker, usá: http://localhost:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Solo si GENERATION_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Solo si GENERATION_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_API_KEY=

# --- RAG: base vectorial ---
# "chroma" (default, local, sin cuentas) o "pinecone" (nube, Serverless)
VECTOR_STORE=chroma
CHROMA_COLLECTION=documentos_tecnicos

# Solo si VECTOR_STORE=pinecone (plan gratis en https://app.pinecone.io/)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=intelligence-system
PINECONE_NAMESPACE=documentos-tecnicos
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- RAG: embeddings ---
# "fastembed" (default, local, multilingüe), "openai" (de pago)
EMBEDDINGS_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=100
RAG_TOP_K=3

# --- Estado, cola y checkpoints ---
# "redis" (default; Redis Stack, ya incluido en el compose), "sqlite" o "memory" (solo pruebas)
CHECKPOINTER=redis
JOB_TTL_SECONDS=86400

# --- Orquestador ---
WORKER_CONCURRENCY=5
RECURSION_LIMIT=25
MAX_PASOS_SUPERVISOR=6

# --- Observabilidad (Arize Phoenix) ---
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=intelligence-system
